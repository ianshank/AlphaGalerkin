{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MPLBACKEND": "Agg",
    "WANDB_MODE": "disabled",
    "PYTHONHASHSEED": "0",
    "COVERAGE_CORE": "pytrace"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session_start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(python -m mypy:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m coverage:*)",
      "Bash(pre-commit run:*)",
      "Bash(python -m src.poc.cli:*)",
      "Bash(python -m src.agents.cli:*)",
      "Bash(python -m src.tools.verify_invariance:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git worktree:*)",
      "Bash(python -m scripts.audit_abstractions:*)",
      "Bash(python -m scripts.check_focus:*)",
      "Bash(python -m scripts.check_doc_links:*)",
      "Bash(python -m scripts.run_lshape_amr:*)",
      "Bash(python -m scripts.spikes.skfem_substrate_spike:*)",
      "Bash(python -m scripts.run_adaptive_vs_uniform:*)",
      "Bash(python -m scripts.run_transfer_baseline_compare:*)",
      "Bash(python -m scripts.run_stochastic_galerkin_compare:*)",
      "Bash(python -m scripts.run_sbir_p40:*)",
      "Bash(python -m scripts.run_sbir_demo:*)"
    ]
  }
}
